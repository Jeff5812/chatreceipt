# Copy to backend/.env and fill in. Never commit .env.

# Which AI provider reads screenshots: auto, anthropic or gemini.
# "auto" uses Anthropic when ANTHROPIC_API_KEY is set, otherwise Gemini when GEMINI_API_KEY is set.
# Without either key, people can still enter details manually.
EXTRACTION_PROVIDER=auto

# Anthropic (Claude)
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=high

# Google (Gemini). The key can also come from the GEMINI_API_KEY environment variable,
# which keeps it out of this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional for Gemini 3 models: low or high. Empty uses the model's default.
GEMINI_THINKING_LEVEL=

# Comma-separated origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000

# Behind a hosting proxy (Render, for example) set TRUST_PROXY_HEADERS=true so rate limits count each
# visitor, and CLIENT_IP_HEADER to a header the proxy sets itself (cf-connecting-ip on Render).
# Leave both off when the API is reached directly.
TRUST_PROXY_HEADERS=false
CLIENT_IP_HEADER=

# Browser used for PDF/PNG export: leave empty for Playwright's bundled Chromium
# (python -m playwright install chromium), or use an installed browser: msedge or chrome.
BROWSER_CHANNEL=msedge

# ---- WhatsApp channel and saved records (optional; see docs/whatsapp-integration.md) ----
# Leave these empty and the website works exactly as before, without storing anything.

# PostgreSQL, for example your Supabase connection string. Apply the schema with: python -m app.db.migrate
DATABASE_URL=

# From your Meta app (WhatsApp > API setup, and App settings > Basic for the app secret).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ChatReceipt's number as people dial it (2348012345678), for the link on each receipt that lets the
# other person confirm it. Empty: receipts carry no confirmation link.
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_APP_SECRET=
# A long random value you choose, and enter again in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0
# The customers' time zone, used to turn a chat's "Today" or "Yesterday" into a date.
WHATSAPP_TIMEZONE=Africa/Lagos

# The public website address used in links sent over WhatsApp. Empty uses the first FRONTEND_ORIGINS.
PUBLIC_WEB_URL=

# A second Gemini model that answers when the main one is overloaded or hasn't answered within
# GEMINI_PRIMARY_TIMEOUT_SECONDS. Empty disables it.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_PRIMARY_TIMEOUT_SECONDS=60
# A small, fast model for short text tasks such as typed WhatsApp corrections. Empty uses GEMINI_MODEL.
GEMINI_LIGHT_MODEL=gemini-2.5-flash-lite

# The number's two-step verification PIN. Written here by `python -m scripts.whatsapp_profile register`,
# which needs it to apply a new display name. Keep it private.
WHATSAPP_REGISTRATION_PIN=

# Set to false if you run the worker separately with: python -m app.whatsapp.worker
WHATSAPP_WORKER_IN_PROCESS=true

# Limits per customer.
WHATSAPP_IMAGES_PER_HOUR=30
WHATSAPP_IMAGES_PER_DAY=100
WHATSAPP_MESSAGES_PER_MINUTE=30

# ---- Transaction engine and the /api/v1 API (needs DATABASE_URL; see ARCHITECTURE.md) ----

# Where uploaded screenshots and issued receipts are kept (default backend/var/storage; leave the
# line commented out rather than empty), and for how long uploads are kept.
# STORAGE_DIR=/srv/chatreceipt/storage
UPLOAD_RETENTION_DAYS=30

# Background jobs. Set ENGINE_WORKER_IN_PROCESS=false if you run: python -m app.engine.worker
ENGINE_WORKER_IN_PROCESS=true
ENGINE_JOB_CONCURRENCY=2
ENGINE_JOB_MAX_ATTEMPTS=4
ENGINE_RETRY_BASE_SECONDS=15
ENGINE_RETRY_MAX_SECONDS=900

# Review policy. "needs_review" also sends medium-confidence money values to a person.
REVIEW_MEDIUM_CONFIDENCE_FINANCIAL=inferred
REVIEW_BLOCK_POSSIBLE_DUPLICATES=true
# Read 03/04/2026 in pasted chats as 3 April (true) or March 4 (false) when the chat doesn't settle it.
TEXT_DATES_DAY_FIRST=true

# Optional: signed event deliveries (for example to n8n). Events: transaction.approved,
# receipt.generated, transaction.completed, processing.failed. Empty WEBHOOK_URL turns them off.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional: a token that protects GET /api/metrics. Empty turns the endpoint off.
METRICS_TOKEN=

# Requests per customer per window (seconds) for the v1 API.
V1_PROCESSING_RATE_LIMIT=30
V1_PROCESSING_RATE_WINDOW_SECONDS=600
V1_UPLOAD_RATE_LIMIT=200
V1_WRITE_RATE_LIMIT=600
